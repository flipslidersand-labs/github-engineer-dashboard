# GitHub personal access token (classic or fine-grained, read-only).
# サーバー全体で使う既定トークン。未設定でもリクエストごとに
# X-GitHub-Token ヘッダーで渡せる。
GITHUB_TOKEN=

# GitHub API のベース URL（GitHub Enterprise の場合のみ変更）
GITHUB_API_URL=https://api.github.com

# AI レビュー用（Claude Haiku）。未設定時は Ollama にフォールバック
ANTHROPIC_API_KEY=

# Ollama フォールバックのエンドポイントとモデル名
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ローカルで Go バックエンドを併用する場合に指定（例: http://localhost:8080）
GO_BACKEND_URL=

# サーバーの待受ポート（Render では $PORT が自動設定される）
PORT=8000

# SQLite レスポンスキャッシュのパスと TTL（秒）
CACHE_DB=cache.db
CACHE_TTL_SECONDS=300

# 許可するフロントエンド Origin（カンマ区切り）。
# 既定は空 = クロスオリジンアクセスを一切許可しない（同一オリジンのみ）。
# GITHUB_TOKEN を設定している場合、Go バックエンドは "*" を無視し
# 何のオリジンも許可しない（Issue #123: サーバー側トークンを
# 任意のサイトに乗っ取られるのを防ぐため）。運用時は自ドメインを
# 明示的に指定すること（例: https://example.com）。
CORS_ORIGINS=
